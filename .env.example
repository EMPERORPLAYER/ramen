# ===========================================================
#  RAMEN HABARU — конфігурація payment API
#  Скопіюйте у .env та заповніть:  copy .env.example .env
# ===========================================================

# ---- сервер ----
PORT=8080
# зовнішній адрес (для редіректів та вебхуків) — у проді https://habaru.ua
BASE_URL=http://localhost:8080
SITE_DIR=

# ---- Монобанк ----
# особистий токен мерчанта: monobank.ua/api/ -> "Токен" сторінки мерчанта
MONO_TOKEN=
# секрет для перевірки підпису вебхука (кабінет мерчанта -> Webhook)
MONO_WEBHOOK_SECRET=

# ---- Приват24 (eCom / мерчант API) ----
P24_MERCHANT_ID=
P24_MERCHANT_PASSWORD=
# 1 = тестовий режим (гроші не списуються), 0 = робочий
P24_SANDBOX=1
# 1 = перевіряти підпис ecosign у вебхуку
P24_VERIFY_SIGN=1
